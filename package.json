{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-acknowledgments.mjs && tsc --noEmit && vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "validate": "tsc --noEmit && eslint . --max-warnings 0 && prettier --check \"src/**/*.{ts,tsx,css}\"",
    "electron:compile": "tsc --ignoreConfig electron/main.ts electron/preload.ts --outDir dist-electron --module commonjs --target es6 --esModuleInterop --skipLibCheck && echo '{\"type\": \"commonjs\"}' > dist-electron/package.json",
    "electron:run": "wait-on tcp:8081 && pnpm run electron:compile && cross-env VITE_DEV_SERVER_URL=http://localhost:8081 electron .",
    "electron": "node scripts/electron-dev-runner.mjs",
    "electron:build": "pnpm run build && pnpm run electron:compile && electron-builder --publish never",
    "electron:dev": "pnpm run electron",
    "mobile:refresh": "pnpm run build && pnpm exec cap sync ios && pnpm exec cap sync android",
    "mobile:sync": "pnpm run build && cap sync",
    "android:build:apk": "pnpm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "android:build:apk:release": "pnpm run build && cap sync android && cd android && ./gradlew assembleRelease",
    "ios:build:simulator": "pnpm run build && cap sync ios && xcodebuild -workspace ios/App/App.xcodeproj/project.xcworkspace -scheme App -configuration Release -sdk iphonesimulator -derivedDataPath ios/build/DerivedData CODE_SIGNING_ALLOWED=NO build",
    "release:local": "cross-env ELECTRON_BUILDER_CACHE=.cache/electron-builder pnpm run electron:build && pnpm run android:build:apk && pnpm run ios:build:simulator"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capawesome/capacitor-file-picker": "^8.0.4",
    "@hookform/resolvers": "^5.8.0",
    "@radix-ui/react-alert-dialog": "^1.1.18",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-context-menu": "^2.2.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^4.4.0",
    "dexie": "^4.2.1",
    "html2canvas": "^1.4.1",
    "i18next": "^26.0.3",
    "idb-keyval": "^6.2.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^1.28.0",
    "lucide-react-motion": "^0.5.0",
    "motion": "^13.0.0",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "react": "^19.2.4",
    "react-day-picker": "^10.0.0",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.53.0",
    "react-i18next": "^17.0.2",
    "react-joyride": "^3.0.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^14.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/ios": "^8.1.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/ui": "^4.1.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.1",
    "cross-env": "^10.1.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "eslint": "^10.0.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.4.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.47",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.0",
    "wait-on": "^9.0.4"
  },
  "packageManager": "pnpm@10.10.0+sha512.d615db246fe70f25dcfea6d8d73dee782ce23e2245e3c4f6f888249fb568149318637dca73c2c5c8ef2a4ca0d5657fb9567188bfab47f566d1ee6ce987815c39",
  "build": {
    "appId": "com.vaultedmoney.app",
    "productName": "Vaulted Money",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
